# ─────────────────────────────────────────────────────────
# PaySplit MERN - Backend Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file
# ─────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-app.netlify.app

# ─── MySQL (Local Development Only) ──────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=salary_expense_db
DB_USER=root
DB_PASS=your_mysql_password

# ─── MongoDB Atlas (Production) ───────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/salary_expense_db?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# ─── Email / OTP (optional - logs to console if not set) ─
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
